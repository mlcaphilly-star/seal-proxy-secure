  function renderEnrollmentPreview(data, customerEmail) {
    const enrollments = (data.enrollments || []).filter(row =>
      String(row.status || "").toUpperCase() === "ACTIVE"
    );

    enrollmentPreviewPanel.style.display = "block";
    enrollmentPreviewPanel.open = true;

    if (!data.success || !enrollments.length) {
      enrollmentPreviewPanel.querySelector("summary").textContent = "Enrollment Preview Result";
      enrollmentPreviewResults.innerHTML = `<p>No active enrollments found for ${escapeHtml(customerEmail)}.</p>`;
      return;
    }

    const groups = groupEnrollmentPreviewRows(enrollments);
    enrollmentPreviewPanel.querySelector("summary").textContent = `Enrollment Preview Result (${groups.length} participant${groups.length === 1 ? "" : "s"})`;

    enrollmentPreviewResults.innerHTML = `
      <h3 style="font-size:1.05rem;margin:0 0 0.75rem;">My Enrollments Preview</h3>
      <table style="width:100%;border-collapse:collapse;">
        ${groups.map(renderEnrollmentPreviewGroup).join("")}
      </table>
    `;

    enrollmentPreviewResults.querySelectorAll("[data-admin-payment-history]").forEach(link => {
      link.addEventListener("click", event => {
        event.preventDefault();
        const reportRow = document.getElementById(link.dataset.adminPaymentHistory);
        if (!reportRow) return;
        const isHidden = reportRow.style.display === "none";
        reportRow.style.display = isHidden ? "table-row" : "none";
        const productLabel = link.dataset.productLabel || link.textContent.replace(/^Hide /, "");
        link.dataset.productLabel = productLabel;
        link.textContent = isHidden ? `Hide ${productLabel}` : productLabel;
      });
    });
  }

