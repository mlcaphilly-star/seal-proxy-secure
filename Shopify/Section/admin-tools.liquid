{% assign is_admin = false %}
{% if customer and customer.tags contains 'SUPERUSER' %}
  {% assign is_admin = true %}
{% endif %}
{% if customer and customer.tags contains 'ADMIN' or customer and customer.tags contains 'Admin' or customer and customer.tags contains 'admin' %}
  {% assign is_admin = true %}
{% endif %}

{% if is_admin %}
<section class="admin-tools" style="max-width:1100px;margin:0 auto;padding:2rem;">
  <h1 style="margin-bottom:1rem;">Admin Tools</h1>

  <div style="border:1px solid #ddd;border-radius:6px;padding:1rem;margin-bottom:1rem;">
    <h2 style="font-size:1.25rem;margin:0 0 0.75rem;">Holiday Schedule</h2>
    <p style="margin-top:0;">Add closure periods used to exclude holidays from vacation credit calculations.</p>
    <div style="display:grid;grid-template-columns:1.4fr 1fr 1fr auto;gap:0.5rem;align-items:end;">
      <div>
        <label for="holidayName" style="display:block;font-weight:600;margin-bottom:0.35rem;">Holiday Name</label>
        <input id="holidayName" type="text" placeholder="Thanksgiving 2026" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
      </div>
      <div>
        <label for="holidayFrom" style="display:block;font-weight:600;margin-bottom:0.35rem;">From Date</label>
        <input id="holidayFrom" type="date" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
      </div>
      <div>
        <label for="holidayTo" style="display:block;font-weight:600;margin-bottom:0.35rem;">To Date</label>
        <input id="holidayTo" type="date" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
      </div>
      <button id="addHoliday" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#111;color:#fff;">Add Holiday</button>
    </div>
    <div id="holidayList" style="margin-top:1rem;overflow-x:auto;"></div>
  </div>

  <div style="border:1px solid #ddd;border-radius:6px;padding:1rem;margin-bottom:1rem;">
    <label for="adminKey" style="display:block;font-weight:600;margin-bottom:0.35rem;">Admin Key</label>
    <input id="adminKey" type="password" autocomplete="off" style="width:100%;max-width:420px;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
    <button id="saveAdminKey" type="button" style="margin-left:0.5rem;padding:0.55rem 0.9rem;border:0;border-radius:4px;background:#111;color:#fff;">Use Key</button>
    <span id="keyStatus" style="margin-left:0.75rem;font-weight:600;"></span>
  </div>

  <div style="display:flex;flex-direction:column;gap:1rem;">
    <div style="border:1px solid #ddd;border-radius:6px;padding:1rem;">
      <h2 style="font-size:1.25rem;margin:0 0 0.75rem;">Reports</h2>

      <div style="display:flex;flex-direction:column;gap:0.75rem;">
        <button class="admin-report" data-path="/admin/seal-report" type="button" style="padding:0.65rem;border:0;border-radius:4px;background:#2563eb;color:#fff;text-align:left;">
          Active Seal Subscription Report
        </button>

        <button class="admin-report" data-path="/admin/outdoor-warminster-participants" type="button" style="padding:0.65rem;border:0;border-radius:4px;background:#2563eb;color:#fff;text-align:left;">
          Outdoor Coaching Participants
        </button>

        <button id="showCurrentVacations" type="button" style="padding:0.65rem;border:0;border-radius:4px;background:#0f766e;color:#fff;text-align:left;">
          Current Vacations
        </button>

        <div>
          <label for="reportProduct" style="display:block;font-weight:600;margin-bottom:0.35rem;">Active Participants Product</label>
          <select id="reportProduct" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.5rem;">
            <option value="">Enter admin key, then load products</option>
          </select>
          <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
            <button id="loadReportProducts" type="button" style="padding:0.55rem 0.8rem;border:0;border-radius:4px;background:#111;color:#fff;">
              Load Products
            </button>
            <button id="downloadProductParticipants" type="button" style="padding:0.55rem 0.8rem;border:0;border-radius:4px;background:#2563eb;color:#fff;">
              Download Participants
            </button>
          </div>
        </div>

        <div>
          <label for="upcomingMonth" style="display:block;font-weight:600;margin-bottom:0.35rem;">Upcoming Payments Month</label>
          <input id="upcomingMonth" type="month" style="padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
          <button id="downloadUpcoming" type="button" style="margin-left:0.35rem;padding:0.6rem 0.8rem;border:0;border-radius:4px;background:#2563eb;color:#fff;">
            Download
          </button>
        </div>
      </div>
      <div id="reportResults" style="margin-top:1rem;overflow-x:auto;"></div>
    </div>

    <div style="border:1px solid #ddd;border-radius:6px;padding:1rem;">
      <h2 style="font-size:1.25rem;margin:0 0 0.75rem;">Waiver Dashboard</h2>

      <div style="border-bottom:1px solid #ddd;padding-bottom:1rem;margin-bottom:1rem;">
        <h3 style="font-size:1rem;margin:0 0 0.75rem;">Search Waivers</h3>
        <div style="display:grid;grid-template-columns:1fr auto;gap:0.5rem;align-items:end;">
          <label for="waiverSearch" style="display:block;font-weight:600;">
            Search by signer, participant, email, order, or waiver ID
            <input id="waiverSearch" type="search" placeholder="Waiver Search..." style="display:block;width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-top:0.35rem;">
          </label>
          <button id="searchWaivers" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#f58220;color:#fff;">
            Search
          </button>
        </div>
        <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;margin-top:0.75rem;">
          <label for="waiverStatusFilter" style="font-weight:600;">Status</label>
          <select id="waiverStatusFilter" style="padding:0.5rem;border:1px solid #bbb;border-radius:4px;">
            <option value="">All</option>
            <option value="submitted">Submitted</option>
            <option value="pending_checkout">Pending Checkout</option>
            <option value="paid">Paid</option>
          </select>
          <button id="loadRecentWaivers" type="button" style="padding:0.55rem 0.8rem;border:0;border-radius:4px;background:#2563eb;color:#fff;">
            Load Recent
          </button>
        </div>
        <div id="waiverSearchResults" style="margin-top:1rem;overflow-x:auto;"></div>
      </div>

      <div>
        <h3 style="font-size:1rem;margin:0 0 0.75rem;">Waiver Forms</h3>
        <input id="waiverFormId" type="hidden">
        <label for="waiverFormTitleInput" style="display:block;font-weight:600;margin-bottom:0.35rem;">Form Title</label>
        <input id="waiverFormTitleInput" type="text" placeholder="Medical & Legal Liability Waiver" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;">

        <div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap;margin-bottom:0.35rem;">
          <label for="waiverRichEditor" style="display:block;font-weight:600;">Enter your Agreement Text</label>
          <label style="display:flex;align-items:center;gap:0.35rem;font-weight:600;">
            <input id="waiverEditorAdvanced" type="checkbox">
            <span>Show advanced editor tools</span>
          </label>
        </div>
        <div class="waiver-editor-shell" style="border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;background:#fff;">
          <div class="waiver-editor-toolbar" style="display:flex;gap:0.25rem;flex-wrap:wrap;align-items:center;padding:0.35rem;border-bottom:1px solid #ccc;background:#eee;">
            <button type="button" data-waiver-command="undo" title="Undo">Undo</button>
            <button type="button" data-waiver-command="redo" title="Redo">Redo</button>
            <span style="width:1px;height:24px;background:#bbb;margin:0 0.25rem;"></span>
            <button type="button" data-waiver-command="bold" title="Bold"><strong>B</strong></button>
            <button type="button" data-waiver-command="italic" title="Italic"><em>I</em></button>
            <button type="button" data-waiver-command="underline" title="Underline"><u>U</u></button>
            <span style="width:1px;height:24px;background:#bbb;margin:0 0.25rem;"></span>
            <button type="button" data-waiver-command="justifyLeft" title="Align left">Left</button>
            <button type="button" data-waiver-command="justifyCenter" title="Align center">Center</button>
            <button type="button" data-waiver-command="justifyRight" title="Align right">Right</button>
            <span style="width:1px;height:24px;background:#bbb;margin:0 0.25rem;"></span>
            <button type="button" data-waiver-command="insertUnorderedList" title="Bullet list">Bullets</button>
            <button type="button" data-waiver-command="insertOrderedList" title="Numbered list">Numbers</button>
            <button type="button" data-waiver-command="outdent" title="Decrease indent">Outdent</button>
            <button type="button" data-waiver-command="indent" title="Increase indent">Indent</button>
            <span class="waiver-editor-advanced-tools" style="display:none;gap:0.25rem;flex-wrap:wrap;align-items:center;">
              <span style="width:1px;height:24px;background:#bbb;margin:0 0.25rem;"></span>
              <button type="button" data-waiver-command="createLink" title="Insert link">Link</button>
              <button type="button" data-waiver-command="removeFormat" title="Remove formatting">Clear Format</button>
              <select id="waiverFormatBlock" title="Text style" style="min-height:32px;border:1px solid #bbb;background:#fff;">
                <option value="p">Paragraph</option>
                <option value="h2">Heading 2</option>
                <option value="h3">Heading 3</option>
              </select>
              <select id="waiverMergeTag" title="Insert waiver field" style="min-height:32px;border:1px solid #bbb;background:#fff;">
                <option value="">Waiver Tools</option>
                <option value="{% raw %}{{FIRST_NAME}}{% endraw %}">{% raw %}{{FIRST_NAME}}{% endraw %}</option>
                <option value="{% raw %}{{LAST_NAME}}{% endraw %}">{% raw %}{{LAST_NAME}}{% endraw %}</option>
                <option value="{% raw %}{{PARTICIPANT_NAME}}{% endraw %}">{% raw %}{{PARTICIPANT_NAME}}{% endraw %}</option>
                <option value="{% raw %}{{SIGNATURE_DATE}}{% endraw %}">{% raw %}{{SIGNATURE_DATE}}{% endraw %}</option>
              </select>
              <button type="button" id="toggleWaiverSource">HTML Source</button>
            </span>
          </div>
          <div id="waiverRichEditor" contenteditable="true" style="min-height:320px;max-height:560px;overflow:auto;padding:0.75rem;line-height:1.55;outline:none;"></div>
          <textarea id="waiverFormTextInput" rows="10" style="display:none;width:100%;padding:0.55rem;border:0;border-top:1px solid #ccc;"></textarea>
        </div>

        <label style="display:flex;align-items:center;gap:0.45rem;margin-bottom:0.75rem;">
          <input id="waiverFormActiveStandalone" type="checkbox">
          <span>Active on standalone Shopify waiver form</span>
        </label>
        <label style="display:flex;align-items:center;gap:0.45rem;margin-bottom:0.75rem;">
          <input id="waiverFormActiveRegistration" type="checkbox">
          <span>Active on coaching registration form</span>
        </label>

        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button id="loadLiabilityWaiverTemplate" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#6b7280;color:#fff;">
            Load Liability Waiver Template
          </button>
          <button id="saveWaiverForm" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#0f766e;color:#fff;">
            Create New Waiver Form
          </button>
          <button id="clearWaiverForm" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#111;color:#fff;">
            Clear
          </button>
          <button id="loadWaiverForms" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#2563eb;color:#fff;">
            Load Waiver Forms
          </button>
        </div>

        <div id="waiverFormsResults" style="margin-top:1rem;overflow-x:auto;"></div>
      </div>

      <div style="border-top:1px solid #ddd;margin-top:1.25rem;padding-top:1.25rem;">
        <h3 style="font-size:1.1rem;margin:0 0 0.5rem;">Coaching Registration Terms</h3>
        <p style="margin:0 0 0.9rem;color:#555;">Manage the Terms of Service shown on the coaching registration form. Saving a form as active replaces the wording shown to new registrants.</p>

        <input id="termsFormId" type="hidden">
        <label for="termsFormTitleInput" style="display:block;font-weight:600;margin-bottom:0.35rem;">Terms Title</label>
        <input id="termsFormTitleInput" type="text" placeholder="Coaching Enrollment Terms and Conditions" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;">

        <div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;flex-wrap:wrap;margin-bottom:0.35rem;">
          <label for="termsRichEditor" style="display:block;font-weight:600;">Enter your Terms Wording</label>
          <label style="display:flex;align-items:center;gap:0.35rem;font-weight:600;">
            <input id="termsEditorAdvanced" type="checkbox">
            <span>Show advanced editor tools</span>
          </label>
        </div>
        <div class="waiver-editor-shell" style="border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;background:#fff;">
          <div class="waiver-editor-toolbar" style="display:flex;gap:0.25rem;flex-wrap:wrap;align-items:center;padding:0.35rem;border-bottom:1px solid #ccc;background:#eee;">
            <button type="button" data-terms-command="undo" title="Undo">Undo</button>
            <button type="button" data-terms-command="redo" title="Redo">Redo</button>
            <span style="width:1px;height:24px;background:#bbb;margin:0 0.25rem;"></span>
            <button type="button" data-terms-command="bold" title="Bold"><strong>B</strong></button>
            <button type="button" data-terms-command="italic" title="Italic"><em>I</em></button>
            <button type="button" data-terms-command="underline" title="Underline"><u>U</u></button>
            <span style="width:1px;height:24px;background:#bbb;margin:0 0.25rem;"></span>
            <button type="button" data-terms-command="justifyLeft" title="Align left">Left</button>
            <button type="button" data-terms-command="justifyCenter" title="Align center">Center</button>
            <button type="button" data-terms-command="justifyRight" title="Align right">Right</button>
            <span style="width:1px;height:24px;background:#bbb;margin:0 0.25rem;"></span>
            <button type="button" data-terms-command="insertUnorderedList" title="Bullet list">Bullets</button>
            <button type="button" data-terms-command="insertOrderedList" title="Numbered list">Numbers</button>
            <button type="button" data-terms-command="outdent" title="Decrease indent">Outdent</button>
            <button type="button" data-terms-command="indent" title="Increase indent">Indent</button>
            <span class="terms-editor-advanced-tools" style="display:none;gap:0.25rem;flex-wrap:wrap;align-items:center;">
              <span style="width:1px;height:24px;background:#bbb;margin:0 0.25rem;"></span>
              <button type="button" data-terms-command="createLink" title="Insert link">Link</button>
              <button type="button" data-terms-command="removeFormat" title="Remove formatting">Clear Format</button>
              <select id="termsFormatBlock" title="Text style" style="min-height:32px;border:1px solid #bbb;background:#fff;">
                <option value="p">Paragraph</option>
                <option value="h2">Heading 2</option>
                <option value="h3">Heading 3</option>
              </select>
              <button type="button" id="toggleTermsSource">HTML Source</button>
            </span>
          </div>
          <div id="termsRichEditor" contenteditable="true" style="min-height:320px;max-height:560px;overflow:auto;padding:0.75rem;line-height:1.55;outline:none;"></div>
          <textarea id="termsFormTextInput" rows="10" style="display:none;width:100%;padding:0.55rem;border:0;border-top:1px solid #ccc;"></textarea>
        </div>

        <label style="display:flex;align-items:center;gap:0.45rem;margin-bottom:0.75rem;">
          <input id="termsFormActiveRegistration" type="checkbox">
          <span>Active on coaching registration form</span>
        </label>

        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button id="loadCoachingTermsTemplate" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#6b7280;color:#fff;">Load Current / Default Terms</button>
          <button id="saveTermsForm" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#0f766e;color:#fff;">Create New Terms Form</button>
          <button id="clearTermsForm" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#111;color:#fff;">Clear</button>
          <button id="loadTermsForms" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#2563eb;color:#fff;">Load Terms Forms</button>
        </div>

        <div id="termsFormsResults" style="margin-top:1rem;overflow-x:auto;"></div>
      </div>
    </div>

    <div style="border:1px solid #ddd;border-radius:6px;padding:1rem;">
      <h2 style="font-size:1.25rem;margin:0 0 0.75rem;">Bulk Coaching Credit</h2>

      <label for="bulkProduct" style="display:block;font-weight:600;margin-bottom:0.35rem;">Product</label>
      <select id="bulkProduct" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;">
        <option value="">Enter admin key, then load products</option>
      </select>

      <button id="loadProducts" type="button" style="padding:0.55rem 0.8rem;border:0;border-radius:4px;background:#111;color:#fff;margin-bottom:1rem;">
        Load Products
      </button>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.75rem;">
        <div>
          <label for="creditFromDate" style="display:block;font-weight:600;margin-bottom:0.35rem;">From Date</label>
          <input id="creditFromDate" type="date" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
        </div>
        <div>
          <label for="creditToDate" style="display:block;font-weight:600;margin-bottom:0.35rem;">To Date</label>
          <input id="creditToDate" type="date" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
        </div>
      </div>

      <label for="creditDays" style="display:block;font-weight:600;margin-bottom:0.35rem;">Number of Days</label>
      <input id="creditDays" type="number" min="1" max="365" step="1" placeholder="Use this OR from/to dates" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;">

      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        <button id="previewBulkCredit" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#0f766e;color:#fff;">
          Preview
        </button>
        <button id="applyBulkCredit" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#b91c1c;color:#fff;">
          Apply Credit
        </button>
      </div>

      <details id="bulkResultsPanel" class="admin-collapse" style="display:none;margin-top:1rem;border-top:1px solid #ddd;padding-top:0.75rem;" open>
        <summary style="cursor:pointer;font-weight:600;">Bulk Credit Preview</summary>
        <div id="bulkResults" style="margin-top:0.75rem;overflow-x:auto;"></div>
      </details>
    </div>

    <div style="border:1px solid #ddd;border-radius:6px;padding:1rem;">
      <h2 style="font-size:1.25rem;margin:0 0 0.75rem;">Batch Management</h2>

      <div style="border-bottom:1px solid #ddd;padding-bottom:1rem;margin-bottom:1rem;">
        <h3 style="font-size:1rem;margin:0 0 0.75rem;">New Location</h3>

        <label for="locationName" style="display:block;font-weight:600;margin-bottom:0.35rem;">Location Name</label>
        <input id="locationName" type="text" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;">

        <label for="locationAddress1" style="display:block;font-weight:600;margin-bottom:0.35rem;">Address 1</label>
        <input id="locationAddress1" type="text" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;">

        <label for="locationAddress2" style="display:block;font-weight:600;margin-bottom:0.35rem;">Address 2</label>
        <input id="locationAddress2" type="text" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;">

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.75rem;">
          <div>
            <label for="locationCity" style="display:block;font-weight:600;margin-bottom:0.35rem;">City</label>
            <input id="locationCity" type="text" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
          </div>
          <div>
            <label for="locationState" style="display:block;font-weight:600;margin-bottom:0.35rem;">State</label>
            <input id="locationState" type="text" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-bottom:0.75rem;">
          <div>
            <label for="locationZip" style="display:block;font-weight:600;margin-bottom:0.35rem;">Zip</label>
            <input id="locationZip" type="text" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
          </div>
          <div>
            <label for="locationCountry" style="display:block;font-weight:600;margin-bottom:0.35rem;">Country</label>
            <input id="locationCountry" type="text" value="USA" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
          </div>
        </div>

        <label style="display:flex;align-items:center;gap:0.45rem;margin-bottom:0.75rem;">
          <input id="locationIndoor" type="checkbox">
          <span>Indoor Location</span>
        </label>

        <button id="saveLocation" type="button" style="padding:0.65rem 0.9rem;border:0;border-radius:4px;background:#0f766e;color:#fff;">
          Save Location
        </button>
      </div>

      <input id="batchId" type="hidden">

      <label for="batchLocation" style="display:block;font-weight:600;margin-bottom:0.35rem;">Location</label>
      <select id="batchLocation" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;">
        <option value="">Load or create a location first</option>
      </select>

      <label for="batchName" style="display:block;font-weight:600;margin-bottom:0.35rem;">Batch Name</label>
      <input id="batchName" type="text" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;margin-bottom:0.75rem;">

      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:0.75rem;margin-bottom:0.75rem;">
        <div>
          <label for="batchDay" style="display:block;font-weight:600;margin-bottom:0.35rem;">Day</label>
          <select id="batchDay" style="width:100%;padding:0.55rem;border:1px solid #bbb;border-radius:4px;">
            <option value="">Select day</option>
            <option>Monday</option>
            <option>Tuesday</option>
            <option>Wednesday</option>
            <option>Thursday</option>
            <option>Friday</option>
            <option>Saturday</option>
            <option>Sunday</option>
          </select>
        </div>
        <div>
          <label for="batchTime" style="display:block;font-weight:600;margin-bottom:0.35rem;">Start Time</label>
