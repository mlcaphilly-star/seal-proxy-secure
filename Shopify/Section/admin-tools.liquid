Relationship:`;

  const savedKey = sessionStorage.getItem("sealAdminKey") || "";
  if (savedKey) {
    adminKeyInput.value = savedKey;
    keyStatus.textContent = "Key loaded for this browser session.";
  }

  function getAdminKey() {
    return adminKeyInput.value.trim();
  }

  function requireKey() {
    if (!getAdminKey()) {
      adminStatus.textContent = "Enter the admin key first.";
      return false;
    }
    return true;
  }

  function renderHolidayList(data) {
    const holidays = data.holidays || [];
    holidayList.innerHTML = `
      <table style="width:100%;border-collapse:collapse;">
        <thead><tr style="background:#f3f4f6;">
          <th style="border:1px solid #ddd;padding:0.5rem;text-align:left;">Holiday</th>
          <th style="border:1px solid #ddd;padding:0.5rem;text-align:left;">From Date</th>
          <th style="border:1px solid #ddd;padding:0.5rem;text-align:left;">To Date</th>
          <th style="border:1px solid #ddd;padding:0.5rem;text-align:left;">Action</th>
        </tr></thead>
        <tbody>${holidays.map(holiday => `
          <tr>
            <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(holiday.name)}</td>
            <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(holiday.from_date)}</td>
            <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(holiday.to_date)}</td>
            <td style="border:1px solid #ddd;padding:0.5rem;"><button type="button" class="delete-holiday" data-id="${holiday.id}">Delete</button></td>
          </tr>`).join("")}</tbody>
      </table>`;

    holidayList.querySelectorAll(".delete-holiday").forEach(button => {
      button.addEventListener("click", async () => {
        if (!confirm("Delete this holiday?")) return;
        const response = await fetch(buildUrl(`/admin/holidays/${button.dataset.id}`), { method: "DELETE" });
        const result = await response.json();
        if (!result.success) throw new Error(result.error || "Could not delete holiday.");
        await loadHolidays();
      });
    });
  }

  async function loadHolidays() {
    if (!requireKey()) return;
    const response = await fetch(buildUrl("/admin/holidays"));
    const data = await response.json();
    if (!data.success) throw new Error(data.error || "Could not load holidays.");
    renderHolidayList(data);
  }

  function buildUrl(path, params = {}) {
    const url = new URL(proxyBase + path);
    url.searchParams.set("key", getAdminKey());
    for (const [key, value] of Object.entries(params)) {
      if (value) url.searchParams.set(key, value);
    }
    return url.toString();
  }

  function buildPublicUrl(path, params = {}) {
    const url = new URL(proxyBase + path);
    for (const [key, value] of Object.entries(params)) {
      if (value) url.searchParams.set(key, value);
    }
    return url.toString();
  }

  function escapeHtml(value) {
    return String(value || "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    }[char]));
  }

  function textToEditorHtml(value) {
    return String(value || "")
      .split(/\n\s*\n/)
      .map(block => block.trim())
      .filter(Boolean)
      .map(block => `<p>${escapeHtml(block).replace(/\n/g, "<br>")}</p>`)
      .join("");
  }

  function sanitizeWaiverEditorHtml(value) {
    const template = document.createElement("template");
    template.innerHTML = String(value || "");
    template.content.querySelectorAll("script,style,iframe,object,embed,form,input,button").forEach(node => node.remove());
    template.content.querySelectorAll("*").forEach(node => {
      [...node.attributes].forEach(attr => {
        const name = attr.name.toLowerCase();
        if (name.startsWith("on")) node.removeAttribute(attr.name);
        if (name === "href" && /^javascript:/i.test(attr.value || "")) node.removeAttribute(attr.name);
      });
    });
    return template.innerHTML.trim();
  }

  function syncWaiverEditorToSource() {
    waiverFormTextInput.value = waiverSourceMode
      ? waiverFormTextInput.value
      : sanitizeWaiverEditorHtml(waiverRichEditor.innerHTML);
  }

  function setWaiverEditorHtml(value) {
    const html = /<\s*[a-z][\s\S]*>/i.test(String(value || ""))
      ? sanitizeWaiverEditorHtml(value)
      : textToEditorHtml(value);
    waiverRichEditor.innerHTML = html || "<p><br></p>";
    waiverFormTextInput.value = html;
  }

  function getWaiverEditorHtml() {
    syncWaiverEditorToSource();
    return sanitizeWaiverEditorHtml(waiverFormTextInput.value);
  }

  function execWaiverCommand(command) {
    waiverRichEditor.focus();
    if (command === "createLink") {
      const url = prompt("Enter link URL");
      if (!url) return;
      document.execCommand(command, false, url);
      return;
    }
    document.execCommand(command, false, null);
    syncWaiverEditorToSource();
  }

  function syncTermsEditorToSource() {
    termsFormTextInput.value = termsSourceMode
      ? termsFormTextInput.value
      : sanitizeWaiverEditorHtml(termsRichEditor.innerHTML);
  }

  function setTermsEditorHtml(value) {
    const html = /<\s*[a-z][\s\S]*>/i.test(String(value || ""))
      ? sanitizeWaiverEditorHtml(value)
      : textToEditorHtml(value);
    termsRichEditor.innerHTML = html || "<p><br></p>";
    termsFormTextInput.value = html;
  }

  function getTermsEditorHtml() {
    syncTermsEditorToSource();
    return sanitizeWaiverEditorHtml(termsFormTextInput.value);
  }

  function execTermsCommand(command) {
    termsRichEditor.focus();
    if (command === "createLink") {
      const url = prompt("Enter link URL");
      if (!url) return;
      document.execCommand(command, false, url);
    } else {
      document.execCommand(command, false, null);
    }
    syncTermsEditorToSource();
  }

  function isOutdoorEnrollment(enrollment) {
    const product = String(enrollment.product_title || enrollment.program || "").toLowerCase();
    return product.includes("outdoor");
  }

  function isParticipantNameProduct(enrollment) {
    const product = String(enrollment.product_title || enrollment.program || "").toLowerCase();
    return product.includes("outdoor") || product.includes("women");
  }

  function enrollmentParticipantName(enrollment) {
    const childName = `${enrollment.child_first_name || ""} ${enrollment.child_last_name || ""}`.trim();
    return isParticipantNameProduct(enrollment)
      ? enrollment.participant_name || childName
      : childName || enrollment.participant_name || "";
  }

  function assignmentTime(assignment) {
    if (!assignment) return "";
    return assignment.end_time ? `${assignment.time || ""}-${assignment.end_time}` : assignment.time || "";
  }

  function enrollmentBatchLabel(batch) {
    if (!batch) return "-";
    const location = batch.location_name ? `${batch.location_name} - ` : "";
    const schedule = [batch.day, assignmentTime(batch)].filter(Boolean).join(" ");
    return `${location}${batch.batch_name || ""}${schedule ? ` (${schedule})` : ""}`;
  }

  function enrollmentBatchCell(batches) {
    if (!batches.length) return "-";
    return batches.map(batch => escapeHtml(enrollmentBatchLabel(batch))).join("<br>");
  }

  function enrollmentPreviewKey(enrollment) {
    return enrollmentParticipantName(enrollment).trim().toLowerCase();
  }

  function groupEnrollmentPreviewRows(enrollments) {
    const groups = [];
    const groupMap = new Map();

    for (const enrollment of enrollments) {
      const key = enrollmentPreviewKey(enrollment);
      if (!groupMap.has(key)) {
        const group = {
          participant_name: enrollmentParticipantName(enrollment),
          cricclub_id: enrollment.cricclub_id || "",
          program: enrollment.program || "",
          enrollments: []
        };
        groupMap.set(key, group);
        groups.push(group);
      }

      const group = groupMap.get(key);
      if (!group.cricclub_id && enrollment.cricclub_id) group.cricclub_id = enrollment.cricclub_id;
      if ((!group.program || isOutdoorEnrollment({ product_title: group.program })) && enrollment.program && !isOutdoorEnrollment(enrollment)) {
        group.program = enrollment.program;
      }
      if (!group.program && enrollment.program) group.program = enrollment.program;
      group.enrollments.push(enrollment);
    }

    return groups;
  }

  function enrollmentPaymentDate(enrollment) {
    return enrollment.next_payment_date
      ? new Date(enrollment.next_payment_date).toLocaleDateString()
      : "No billing date";
  }

  function enrollmentReportDateValue(value) {
    if (!value) return null;
    const date = new Date(`${String(value).slice(0, 10)}T00:00:00Z`);
    return Number.isNaN(date.getTime()) ? null : date;
  }

  function formatEnrollmentReportDate(value) {
    const date = value instanceof Date ? value : enrollmentReportDateValue(value);
    return date ? date.toLocaleDateString("en-US", { timeZone: "UTC" }) : "";
  }

  function addEnrollmentReportDays(value, days) {
    const date = value instanceof Date ? new Date(value) : enrollmentReportDateValue(value);
    if (!date) return null;
    date.setUTCDate(date.getUTCDate() + Number(days || 0));
    return date;
  }

  function addEnrollmentBillingInterval(value, interval) {
    const date = value instanceof Date ? new Date(value) : enrollmentReportDateValue(value);
    if (!date) return null;
    const normalizedInterval = String(interval || "").toLowerCase();
    if (normalizedInterval.includes("quarter")) {
      date.setUTCMonth(date.getUTCMonth() + 3);
      return date;
    }
    const match = normalizedInterval.match(/(\d+)\s*(day|week|month|year)/);
    if (!match) return null;
    const count = Number(match[1]);
    if (match[2] === "day") date.setUTCDate(date.getUTCDate() + count);
    if (match[2] === "week") date.setUTCDate(date.getUTCDate() + (count * 7));
    if (match[2] === "month") date.setUTCMonth(date.getUTCMonth() + count);
    if (match[2] === "year") date.setUTCFullYear(date.getUTCFullYear() + count);
    return date;
  }

  function enrollmentReportAmount(value) {
    const amount = String(value ?? "").replace(/^\$/, "").trim();
    if (!amount) return "";
    const number = Number(amount);
    return Number.isFinite(number)
      ? number.toLocaleString("en-US", { style: "currency", currency: "USD" })
      : `$${amount}`;
  }

  function enrollmentVacationsForAttempt(enrollment, attempt, periodStart) {
    if (!attempt) return [];
    const attemptId = String(attempt.id || "");
    const vacations = enrollment.vacations || [];
    const exactMatches = vacations.filter(vacation =>
      attemptId && String(vacation.billing_attempt_id || "") === attemptId
    );
    if (exactMatches.length) return exactMatches;

    const currentAttemptIds = new Set(
      (enrollment.billing_attempts || []).map(item => String(item.id || "")).filter(Boolean)
    );
    const start = enrollmentReportDateValue(periodStart);
    const end = enrollmentReportDateValue(attempt.date);
    return vacations.filter(vacation => {
      const vacationAttemptId = String(vacation.billing_attempt_id || "");
      if (vacationAttemptId && currentAttemptIds.has(vacationAttemptId)) return false;
      const vacationStart = enrollmentReportDateValue(vacation.from_date);
      return start && end && vacationStart && vacationStart >= start && vacationStart <= end;
    });
  }

  function renderAdminPaymentHistory(enrollment) {
    const attempts = [...(enrollment.billing_attempts || [])]
      .filter(attempt => attempt.date)
      .sort((a, b) => enrollmentReportDateValue(a.date) - enrollmentReportDateValue(b.date));
    const payments = [...(enrollment.payment_history || [])]
      .filter(payment => payment.payment_date)
      .sort((a, b) => enrollmentReportDateValue(a.payment_date) - enrollmentReportDateValue(b.payment_date))
      .slice(-5);

    if (!payments.length) return "<p>No completed payment history is available yet.</p>";

    const rows = payments.map(payment => {
      const paymentDay = enrollmentReportDateValue(payment.payment_date);
      const paidAttempt = attempts.find(attempt =>
        payment.billing_attempt_id && String(attempt.id || "") === String(payment.billing_attempt_id)
      );
      const periodStart = paidAttempt?.date || paymentDay;
      const nextAttempt = attempts.find(attempt =>
        enrollmentReportDateValue(attempt.date) > enrollmentReportDateValue(periodStart)
      );
      const vacations = enrollmentVacationsForAttempt(enrollment, nextAttempt, periodStart);
      const vacationDays = vacations.reduce((total, vacation) => total + Number(vacation.shift_days || 0), 0);
      const holidayDays = vacations.reduce((total, vacation) => total + Number(vacation.holiday_days || 0), 0);
      const periodEnd = nextAttempt
        ? addEnrollmentReportDays(nextAttempt.date, -vacationDays)
        : addEnrollmentBillingInterval(periodStart, enrollment.payment_frequency);

      return `
        <tr>
          <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(payment.order_number || payment.order_id || "")}</td>
          <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(formatEnrollmentReportDate(paymentDay))}</td>
          <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(formatEnrollmentReportDate(periodStart))}</td>
          <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(formatEnrollmentReportDate(periodEnd))}</td>
          <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(enrollmentReportAmount(payment.amount || enrollment.next_payment_amount))}</td>
          <td style="border:1px solid #ddd;padding:0.5rem;">${vacations.map(v => escapeHtml(formatEnrollmentReportDate(v.from_date))).join("<br>")}</td>
          <td style="border:1px solid #ddd;padding:0.5rem;">${vacations.map(v => escapeHtml(formatEnrollmentReportDate(v.to_date))).join("<br>")}</td>
          <td style="border:1px solid #ddd;padding:0.5rem;">${vacationDays || 0}</td>
          <td style="border:1px solid #ddd;padding:0.5rem;">${holidayDays || 0}</td>
          <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(formatEnrollmentReportDate(nextAttempt?.date))}</td>
        </tr>`;
    }).join("");

    return `
      <div style="overflow-x:auto;margin:0.5rem 0 1rem;">
        <table style="width:100%;min-width:980px;border-collapse:collapse;">
          <thead>
            <tr><th colspan="10" style="border:1px solid #111827;padding:0.6rem;text-align:left;background:#1f2937;color:#fff;">${escapeHtml(enrollment.product_title || "Payment History")}</th></tr>
            <tr style="background:#f3f4f6;">
              ${["Order #", "Payment Date", "Period Start Date", "Period End Date", "Payment Amount", "Vacation From", "Vacation To", "# of Days", "Holiday Days", "Next Payment Date"]
                .map(label => `<th style="border:1px solid #ddd;padding:0.5rem;text-align:left;white-space:nowrap;">${label}</th>`).join("")}
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>`;
  }

  function renderEnrollmentPreviewGroup(group, groupIndex) {
    const indoorEnrollments = group.enrollments.filter(enrollment => !isOutdoorEnrollment(enrollment));
    const outdoorEnrollments = group.enrollments.filter(isOutdoorEnrollment);

    return `
      <tbody>
