      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not load waiver forms.");

      renderWaiverForms(data.forms || []);
      adminStatus.textContent = "Waiver forms loaded.";
    } catch (err) {
      adminStatus.textContent = err.message || "Could not load waiver forms.";
    }
  }

  function renderTermsForms(forms) {
    if (!forms.length) {
      termsFormsResults.innerHTML = "<p>No saved terms forms yet. Load the default terms above, review them, and save.</p>";
      termsFormsResults.dataset.forms = "[]";
      return;
    }

    termsFormsResults.dataset.forms = JSON.stringify(forms);
    termsFormsResults.innerHTML = `
      <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
        <thead><tr>
          <th style="border:1px solid #ddd;padding:0.5rem;text-align:left;">Title</th>
          <th style="border:1px solid #ddd;padding:0.5rem;text-align:left;">Registration</th>
          <th style="border:1px solid #ddd;padding:0.5rem;text-align:left;">Updated</th>
          <th style="border:1px solid #ddd;padding:0.5rem;text-align:left;">Action</th>
        </tr></thead>
        <tbody>${forms.map(form => `
          <tr>
            <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(form.title || "")}</td>
            <td style="border:1px solid #ddd;padding:0.5rem;">${form.is_active_registration ? "Active" : ""}</td>
            <td style="border:1px solid #ddd;padding:0.5rem;">${escapeHtml(formatDateTime(form.updated_at || form.created_at))}</td>
            <td style="border:1px solid #ddd;padding:0.5rem;"><button type="button" data-edit-terms-form="${escapeHtml(form.form_id)}" style="padding:0.45rem 0.65rem;border:0;border-radius:4px;background:#0f766e;color:#fff;">Edit</button></td>
          </tr>`).join("")}</tbody>
      </table>`;
  }

  function clearTermsFormEditor() {
    termsFormId.value = "";
    termsFormTitleInput.value = "";
    setTermsEditorHtml("");
    termsFormActiveRegistration.checked = false;
    document.getElementById("saveTermsForm").textContent = "Create New Terms Form";
  }

  async function loadTermsFormsList() {
    if (!requireKey()) return;
    adminStatus.textContent = "Loading coaching terms forms...";
    try {
      const response = await fetch(buildUrl("/admin/coaching-terms"));
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not load coaching terms forms.");
      renderTermsForms(data.forms || []);
      adminStatus.textContent = "Coaching terms forms loaded.";
    } catch (err) {
      adminStatus.textContent = err.message || "Could not load coaching terms forms.";
    }
  }

  async function loadWaiverSearchResults() {
    if (!requireKey()) return;
    adminStatus.textContent = "Loading waivers...";

    try {
      const response = await fetch(buildUrl("/admin/coaching-waivers", {
        q: waiverSearch.value.trim(),
        status: waiverStatusFilter.value,
        limit: "50"
      }));
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not load waivers.");

      renderWaiverSearchResults(data.waivers || []);
      adminStatus.textContent = "Waivers loaded.";
    } catch (err) {
      adminStatus.textContent = err.message || "Could not load waivers.";
    }
  }

  saveAdminKey.addEventListener("click", () => {
    if (!getAdminKey()) {
      keyStatus.textContent = "Enter a key.";
      return;
    }
    sessionStorage.setItem("sealAdminKey", getAdminKey());
    keyStatus.textContent = "Key saved for this browser session.";
    loadHolidays().catch(err => { adminStatus.textContent = err.message; });
  });

  document.getElementById("addHoliday").addEventListener("click", async () => {
    if (!requireKey()) return;
    if (!holidayName.value.trim() || !holidayFrom.value || !holidayTo.value) {
      adminStatus.textContent = "Enter holiday name, from date, and to date.";
      return;
    }

    try {
      const response = await fetch(buildUrl("/admin/holidays"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: holidayName.value.trim(),
          from_date: holidayFrom.value,
          to_date: holidayTo.value
        })
      });
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not add holiday.");
      holidayName.value = "";
      holidayFrom.value = "";
      holidayTo.value = "";
      await loadHolidays();
      adminStatus.textContent = "Holiday added.";
    } catch (err) {
      adminStatus.textContent = err.message || "Could not add holiday.";
    }
  });

  if (getAdminKey()) loadHolidays().catch(err => { adminStatus.textContent = err.message; });

  document.querySelectorAll(".admin-report").forEach(button => {
    button.addEventListener("click", () => {
      if (!requireKey()) return;
      window.open(buildUrl(button.dataset.path), "_blank");
    });
  });

  document.getElementById("downloadUpcoming").addEventListener("click", () => {
    if (!requireKey()) return;
    if (!upcomingMonth.value) {
      adminStatus.textContent = "Choose a month for the upcoming payments report.";
      return;
    }
    window.open(buildUrl("/seal-upcoming-payments", { month: upcomingMonth.value }), "_blank");
  });

  downloadProductParticipants.addEventListener("click", () => {
    if (!requireKey()) return;
    if (!reportProduct.value) {
      adminStatus.textContent = "Select a product for the participants report.";
      return;
    }
    window.open(buildUrl("/admin/product-participants", { product_title: reportProduct.value }), "_blank");
  });

  document.getElementById("searchWaivers").addEventListener("click", loadWaiverSearchResults);
  document.getElementById("loadRecentWaivers").addEventListener("click", () => {
    waiverSearch.value = "";
    loadWaiverSearchResults();
  });
  waiverSearch.addEventListener("keydown", event => {
    if (event.key === "Enter") {
      event.preventDefault();
      loadWaiverSearchResults();
    }
  });
  document.getElementById("loadWaiverForms").addEventListener("click", loadWaiverFormsList);
  document.getElementById("clearWaiverForm").addEventListener("click", clearWaiverFormEditor);
  document.getElementById("loadLiabilityWaiverTemplate").addEventListener("click", () => {
    waiverFormTitleInput.value = liabilityWaiverTemplateTitle;
    setWaiverEditorHtml(liabilityWaiverTemplateText);
    adminStatus.textContent = "Liability waiver template loaded. Review, choose active placement, then save.";
  });
  waiverRichEditor.addEventListener("input", syncWaiverEditorToSource);
  document.querySelectorAll("[data-waiver-command]").forEach(button => {
    button.addEventListener("click", () => execWaiverCommand(button.dataset.waiverCommand));
  });
  waiverEditorAdvanced.addEventListener("change", () => {
    document.querySelectorAll(".waiver-editor-advanced-tools").forEach(panel => {
      panel.style.display = waiverEditorAdvanced.checked ? "flex" : "none";
    });
  });
  waiverFormatBlock.addEventListener("change", () => {
    waiverRichEditor.focus();
    document.execCommand("formatBlock", false, waiverFormatBlock.value);
    syncWaiverEditorToSource();
  });
  waiverMergeTag.addEventListener("change", () => {
    if (!waiverMergeTag.value) return;
    waiverRichEditor.focus();
    document.execCommand("insertText", false, waiverMergeTag.value);
    waiverMergeTag.value = "";
    syncWaiverEditorToSource();
  });
  toggleWaiverSource.addEventListener("click", () => {
    if (waiverSourceMode) {
      setWaiverEditorHtml(waiverFormTextInput.value);
      waiverFormTextInput.style.display = "none";
      waiverRichEditor.style.display = "block";
      toggleWaiverSource.textContent = "HTML Source";
      waiverSourceMode = false;
    } else {
      syncWaiverEditorToSource();
      waiverRichEditor.style.display = "none";
      waiverFormTextInput.style.display = "block";
      toggleWaiverSource.textContent = "Visual Editor";
      waiverSourceMode = true;
    }
  });

  document.getElementById("saveWaiverForm").addEventListener("click", async () => {
    if (!requireKey()) return;

    const payload = buildWaiverFormPayload();
    if (!payload.title || !payload.waiver_text) {
      adminStatus.textContent = "Waiver form title and text are required.";
      return;
    }

    const editing = Boolean(waiverFormId.value);
    adminStatus.textContent = editing ? "Updating waiver form..." : "Creating waiver form...";

    try {
      const response = await fetch(buildUrl(editing ? `/admin/waiver-forms/${waiverFormId.value}` : "/admin/waiver-forms"), {
        method: editing ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not save waiver form.");

      adminStatus.textContent = editing ? "Waiver form updated." : "Waiver form created.";
      clearWaiverFormEditor();
      await loadWaiverFormsList();
    } catch (err) {
      adminStatus.textContent = err.message || "Could not save waiver form.";
    }
  });

  waiverFormsResults.addEventListener("click", event => {
    const editButton = event.target.closest("[data-edit-waiver-form]");
    if (!editButton) return;

    const forms = JSON.parse(waiverFormsResults.dataset.forms || "[]");
    const form = forms.find(row => String(row.form_id) === String(editButton.dataset.editWaiverForm));
    if (!form) return;

    waiverFormId.value = form.form_id || "";
    waiverFormTitleInput.value = form.title || "";
    setWaiverEditorHtml(form.waiver_text || "");
    waiverFormActiveStandalone.checked = Boolean(form.is_active_standalone);
    waiverFormActiveRegistration.checked = Boolean(form.is_active_registration);
    document.getElementById("saveWaiverForm").textContent = "Update Waiver Form";
    adminStatus.textContent = "Editing waiver form.";
  });

  document.getElementById("loadTermsForms").addEventListener("click", loadTermsFormsList);
  document.getElementById("clearTermsForm").addEventListener("click", clearTermsFormEditor);
  termsRichEditor.addEventListener("input", syncTermsEditorToSource);
  document.querySelectorAll("[data-terms-command]").forEach(button => {
    button.addEventListener("click", () => execTermsCommand(button.dataset.termsCommand));
  });
  termsEditorAdvanced.addEventListener("change", () => {
    document.querySelectorAll(".terms-editor-advanced-tools").forEach(panel => {
      panel.style.display = termsEditorAdvanced.checked ? "flex" : "none";
    });
  });
  termsFormatBlock.addEventListener("change", () => {
    termsRichEditor.focus();
    document.execCommand("formatBlock", false, termsFormatBlock.value);
    syncTermsEditorToSource();
  });
  toggleTermsSource.addEventListener("click", () => {
    if (termsSourceMode) {
      setTermsEditorHtml(termsFormTextInput.value);
      termsFormTextInput.style.display = "none";
      termsRichEditor.style.display = "block";
      toggleTermsSource.textContent = "HTML Source";
      termsSourceMode = false;
    } else {
      syncTermsEditorToSource();
      termsRichEditor.style.display = "none";
      termsFormTextInput.style.display = "block";
      toggleTermsSource.textContent = "Visual Editor";
      termsSourceMode = true;
    }
  });
  document.getElementById("loadCoachingTermsTemplate").addEventListener("click", async () => {
    adminStatus.textContent = "Loading current coaching terms...";
    try {
      const response = await fetch(buildPublicUrl("/registration-terms/active"));
      const data = await response.json();
      if (!data.success || !data.form) throw new Error(data.error || "Could not load coaching terms.");
      termsFormTitleInput.value = data.form.title || "";
      setTermsEditorHtml(data.form.terms_text || "");
      termsFormActiveRegistration.checked = true;
      adminStatus.textContent = "Current coaching terms loaded. Review and save to make them admin-managed.";
    } catch (err) {
      adminStatus.textContent = err.message || "Could not load coaching terms.";
    }
  });

  document.getElementById("saveTermsForm").addEventListener("click", async () => {
    if (!requireKey()) return;
    const payload = {
      title: termsFormTitleInput.value.trim(),
      terms_text: getTermsEditorHtml(),
      is_active_registration: termsFormActiveRegistration.checked
    };
    if (!payload.title || !payload.terms_text) {
      adminStatus.textContent = "Terms title and wording are required.";
      return;
    }

    const editing = Boolean(termsFormId.value);
    adminStatus.textContent = editing ? "Updating coaching terms..." : "Creating coaching terms...";
    try {
      const response = await fetch(buildUrl(editing ? `/admin/coaching-terms/${termsFormId.value}` : "/admin/coaching-terms"), {
        method: editing ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not save coaching terms.");
      adminStatus.textContent = editing ? "Coaching terms updated." : "Coaching terms created.";
      clearTermsFormEditor();
      await loadTermsFormsList();
    } catch (err) {
      adminStatus.textContent = err.message || "Could not save coaching terms.";
    }
  });

  termsFormsResults.addEventListener("click", event => {
    const editButton = event.target.closest("[data-edit-terms-form]");
    if (!editButton) return;
    const forms = JSON.parse(termsFormsResults.dataset.forms || "[]");
    const form = forms.find(row => String(row.form_id) === String(editButton.dataset.editTermsForm));
    if (!form) return;
    termsFormId.value = form.form_id || "";
    termsFormTitleInput.value = form.title || "";
    setTermsEditorHtml(form.terms_text || "");
    termsFormActiveRegistration.checked = Boolean(form.is_active_registration);
    document.getElementById("saveTermsForm").textContent = "Update Terms Form";
    adminStatus.textContent = "Editing coaching terms form.";
  });

  document.getElementById("showCurrentVacations").addEventListener("click", async () => {
    if (!requireKey()) return;
    adminStatus.textContent = "Loading current vacations...";

    try {
      const response = await fetch(buildUrl("/admin/current-vacations"));
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not load current vacations.");

      adminStatus.textContent = "Current vacations loaded.";
      renderCurrentVacations(data);
    } catch (err) {
      adminStatus.textContent = err.message || "Could not load current vacations.";
    }
  });

  document.getElementById("loadEnrollmentPreview").addEventListener("click", async () => {
    const email = previewCustomerEmail.value.trim();
    if (!email) {
      adminStatus.textContent = "Enter customer email.";
      return;
    }

    adminStatus.textContent = "Loading enrollment preview...";
    enrollmentPreviewPanel.style.display = "none";
    enrollmentPreviewResults.innerHTML = "";

    try {
      const response = await fetch(buildPublicUrl("/enrollments", { email }));
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not load enrollments.");

      adminStatus.textContent = "Enrollment preview loaded.";
      renderEnrollmentPreview(data, email);
    } catch (err) {
      adminStatus.textContent = err.message || "Could not load enrollment preview.";
    }
  });

  loadReportProducts.addEventListener("click", loadSubscriptionProducts);
  loadProducts.addEventListener("click", loadSubscriptionProducts);

  async function loadBatchList() {
    if (!requireKey()) return;
    adminStatus.textContent = "Loading batches...";
    batchResultsPanel.style.display = "none";

    try {
      const [batchResponse, locationResponse] = await Promise.all([
        fetch(buildUrl("/admin/batches")),
        fetch(buildUrl("/admin/locations"))
      ]);
      const data = await batchResponse.json();
      const locationData = await locationResponse.json();
      if (!data.success) throw new Error(data.error || "Could not load batches.");
      if (!locationData.success) throw new Error(locationData.error || "Could not load locations.");

      adminStatus.textContent = "Batches loaded.";
      populateLocationSelect(locationData.locations || [], batchLocation.value);
      renderBatches(data.batches || []);
    } catch (err) {
      adminStatus.textContent = err.message || "Could not load batches.";
    }
  }

  document.getElementById("loadBatches").addEventListener("click", loadBatchList);
  document.getElementById("clearBatchForm").addEventListener("click", clearBatchForm);

  document.getElementById("saveLocation").addEventListener("click", async () => {
    if (!requireKey()) return;

    const payload = buildLocationPayload();
    if (!payload.location_name || !payload.address_1 || !payload.city || !payload.state || !payload.zip || !payload.country) {
      adminStatus.textContent = "Location name, address 1, city, state, zip, and country are required.";
      return;
    }

    adminStatus.textContent = "Creating location...";
    try {
      const response = await fetch(buildUrl("/admin/locations"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not save location.");

      adminStatus.textContent = "Location created.";
      clearLocationForm();
      await loadBatchList();
      if (data.location?.location_id) {
        batchLocation.value = data.location.location_id;
      }
    } catch (err) {
      adminStatus.textContent = err.message || "Could not save location.";
    }
  });

  document.getElementById("saveBatch").addEventListener("click", async () => {
    if (!requireKey()) return;

    const payload = buildBatchPayload();
    if (!payload.location_id || !payload.batch_name || !payload.day || !payload.time) {
      adminStatus.textContent = "Location, batch name, day, and start time are required.";
      return;
    }

    const editing = Boolean(batchId.value);
    adminStatus.textContent = editing ? "Updating batch..." : "Creating batch...";

    try {
      const response = await fetch(buildUrl(editing ? `/admin/batches/${batchId.value}` : "/admin/batches"), {
        method: editing ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Could not save batch.");

      adminStatus.textContent = editing ? "Batch updated." : "Batch created.";
      clearBatchForm();
      await loadBatchList();
    } catch (err) {
      adminStatus.textContent = err.message || "Could not save batch.";
    }
  });

  batchResults.addEventListener("click", async event => {
    const editButton = event.target.closest("[data-edit-batch]");
    const deleteButton = event.target.closest("[data-delete-batch]");
    const batches = JSON.parse(batchResults.dataset.batches || "[]");

    if (editButton) {
      const batch = batches.find(row => String(row.batch_id) === String(editButton.dataset.editBatch));
      if (!batch) return;

      batchId.value = batch.batch_id || "";
      batchLocation.value = batch.location_id || "";
      batchName.value = batch.batch_name || "";
      batchDay.value = batch.day || "";
      batchTime.value = batch.time || "";
      batchEndTime.value = batch.end_time || "";
      batchComments.value = batch.comments || "";
      batchTrial.checked = Boolean(batch.is_trial_batch);
      document.getElementById("saveBatch").textContent = "Update Batch";
      adminStatus.textContent = "Editing batch.";
      return;
    }

    if (deleteButton) {
      if (!requireKey()) return;
      if (!confirm("Delete this batch? Batches with current assignments cannot be deleted.")) return;

      adminStatus.textContent = "Deleting batch...";
      try {
        const response = await fetch(buildUrl(`/admin/batches/${deleteButton.dataset.deleteBatch}`), {
          method: "DELETE"
        });
        const data = await response.json();
        if (!data.success) throw new Error(data.error || "Could not delete batch.");

        adminStatus.textContent = "Batch deleted.";
        await loadBatchList();
      } catch (err) {
        adminStatus.textContent = err.message || "Could not delete batch.";
      }
    }
  });

  async function submitBulkCredit(dryRun) {
    if (!requireKey()) return;
    if (!bulkProduct.value) {
      adminStatus.textContent = "Select a product.";
      return;
    }
    if (!creditDays.value && (!creditFromDate.value || !creditToDate.value)) {
      adminStatus.textContent = "Enter number of days, or choose both from and to dates.";
      return;
    }
    if (!dryRun && !confirm("This will update billing schedules for all matching subscriptions. Continue?")) {
      return;
    }

    adminStatus.textContent = dryRun ? "Previewing bulk credit..." : "Applying bulk credit...";

    try {
      const response = await fetch(buildUrl("/admin/bulk-credit"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(buildBulkPayload(dryRun))
      });
      const data = await response.json();
      if (!data.success) throw new Error(data.error || "Bulk credit failed.");

      adminStatus.textContent = dryRun
        ? "Preview ready. No billing schedules were changed."
        : "Bulk credit applied.";
      renderBulkResults(data);
    } catch (err) {
      adminStatus.textContent = err.message || "Bulk credit failed.";
    }
  }

  document.getElementById("previewBulkCredit").addEventListener("click", () => submitBulkCredit(true));
  document.getElementById("applyBulkCredit").addEventListener("click", () => submitBulkCredit(false));
});
</script>
{% else %}
<section style="max-width:760px;margin:0 auto;padding:2rem;">
  <h1>Access denied</h1>
  <p>You do not have permission to view this page.</p>
</section>
{% endif %}
