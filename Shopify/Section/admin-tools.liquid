  const liabilityWaiverTemplateTitle = "Participant Waiver, Release of Liability, Assumption of Risk, Medical Authorization & Photo Release";
  const liabilityWaiverTemplateText = `This Agreement is valid for six (6) months from the date of signing and applies to all activities conducted by StarSportsUS LLC, doing business as Major League Cricket Academy Philadelphia and StarSportsUS Indoor Sports Facility (collectively referred to as the 'Academy').

